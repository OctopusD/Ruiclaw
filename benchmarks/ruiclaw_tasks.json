{
  "schema_version": 1,
  "description": "Fixed deterministic harness regression tasks for RuiClaw Bench v1.",
  "tasks": [
    {
      "id": "readme_intro_locked",
      "prompt": "Replace the placeholder README opening with the locked benchmark sentence.",
      "fixture_repo": "benchmarks/fixtures/bench_repo_readme",
      "allowed_tools": ["read_file", "edit_file"],
      "step_budget": 3,
      "expected_artifact": "README.md",
      "verifier": {"kind": "file_contains", "path": "README.md", "contains": "This fixture is a locked RuiClaw benchmark workspace."},
      "category": "documentation",
      "script": [
        {"content": "", "tool_calls": [{"id": "read-readme", "name": "read_file", "arguments": {"path": "README.md"}}]},
        {"content": "", "tool_calls": [{"id": "edit-readme", "name": "edit_file", "arguments": {"path": "README.md", "old_text": "This is a placeholder RuiClaw benchmark fixture.", "new_text": "This fixture is a locked RuiClaw benchmark workspace."}}]},
        {"content": "Done.", "tool_calls": []}
      ]
    },
    {
      "id": "sample_beta_locked",
      "prompt": "Change beta to beta-locked in sample.txt.",
      "fixture_repo": "benchmarks/fixtures/bench_repo_patch",
      "allowed_tools": ["read_file", "edit_file"],
      "step_budget": 3,
      "expected_artifact": "sample.txt",
      "verifier": {"kind": "file_contains", "path": "sample.txt", "contains": "beta-locked"},
