      "allowed_tools": ["read_file"],
      "step_budget": 1,
      "expected_artifact": "README.md",
      "verifier": {"kind": "run_bundle", "required_events": ["run_started", "context_built", "model_call_started", "model_call_finished", "run_finished"]},
      "category": "observability",
      "script": [
        {"content": "Evidence captured.", "tool_calls": []}
      ]
    }
  ]
}
