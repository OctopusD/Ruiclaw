        {"content": "", "tool_calls": [{"id": "edit-beta", "name": "edit_file", "arguments": {"path": "sample.txt", "old_text": "beta", "new_text": "beta-locked"}}]},
        {"content": "Done.", "tool_calls": []}
      ]
    },
    {
